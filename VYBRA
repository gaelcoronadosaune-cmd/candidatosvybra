<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>VYBRA AHORA – El cambio empieza contigo</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=DM+Sans:wght@400;500;700&display=swap">
<style>
:root{--bg:#F3F8FF;--ink:#061A44;--muted:#4A5F8C;--card:#fff;--line:#CFE0FA;--blue:#1E5BFF;--yellow:#19B5FF;--green:#0A8F6E;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#031038;--ink:#EAF2FF;--muted:#9DB4E0;--card:#0A1F5C;--line:#173A8F;--blue:#5CA2FF;--green:#3DDBA8;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#031038;--ink:#EAF2FF;--muted:#9DB4E0;--card:#0A1F5C;--line:#173A8F;--blue:#5CA2FF;--green:#3DDBA8;color-scheme:dark}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 "DM Sans",system-ui,sans-serif}
h1,h2,h3{font-family:"Bricolage Grotesque","DM Sans",system-ui,sans-serif;line-height:1.05;margin:0}
a{color:inherit}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
nav{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;gap:18px;height:56px;overflow-x:auto;white-space:nowrap}
nav b{font:800 20px "Bricolage Grotesque",sans-serif;margin-right:auto}
nav a{text-decoration:none;font-weight:500;font-size:15px;color:var(--muted)}
nav a:hover{color:var(--ink)}
.hero{background:linear-gradient(135deg,#031038,#0A2A7A 55%,#0B5FE0);color:#fff;padding:64px 0 72px;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center}
.hero h1{font-weight:800;font-size:clamp(46px,9vw,104px);letter-spacing:-.03em}
.hero p{max-width:34em;font-size:19px;margin:22px 0 28px}
.logo{width:220px;height:220px;border-radius:50%;box-shadow:0 0 0 4px rgba(25,181,255,.5),0 0 50px rgba(25,181,255,.55)}
.btn{display:inline-block;background:#19B5FF;color:#031038;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:10px;border:0;font-size:16px;cursor:pointer}
.btn.alt{background:transparent;color:inherit;border:2px solid currentColor;margin-left:8px}
section{padding:64px 0}
h2{font-size:clamp(30px,5vw,46px);letter-spacing:-.02em;margin-bottom:10px}
.lead{color:var(--muted);max-width:40em;margin:0 0 28px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.chip{border:1.5px solid var(--line);background:transparent;color:var(--ink);padding:7px 15px;border-radius:99px;font:500 15px "DM Sans",sans-serif;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.card h3{font-size:22px;margin-bottom:6px}
.card p{margin:0;color:var(--muted);font-size:15px;line-height:1.5}
.tag{display:inline-block;font-size:13px;font-weight:700;color:var(--blue);margin-bottom:8px}
.act{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px}
.act .card{display:flex;flex-direction:column;gap:14px;justify-content:space-between}
.act .btn{background:var(--blue);color:#fff;text-align:center}
:root:not([data-theme="light"]) .act .btn{color:#031038}
.empty{border:2px dashed var(--line);border-radius:14px;padding:22px;color:var(--muted)}
.ev{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--line)}
.ev b{min-width:90px;color:var(--green)}
.band{background:var(--card);border-block:1px solid var(--line)}
.team{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;padding:0;margin:0;list-style:none}
.team li{border-left:4px solid var(--yellow);padding:4px 0 4px 14px}
.team b{display:block}.team span{color:var(--muted);font-size:15px}
footer{padding:32px 0 48px;color:var(--muted);font-size:15px}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:12px 18px;border-radius:10px;font-size:15px;max-width:90%;display:none;z-index:9}
#modal{position:fixed;inset:0;background:rgba(3,16,56,.78);display:none;align-items:center;justify-content:center;z-index:20;padding:12px}
#modal.open{display:flex}
#modal .box{background:var(--card);border-radius:14px;width:min(640px,100%);height:min(90vh,760px);display:flex;flex-direction:column;overflow:hidden}
#modal .bar{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-bottom:1px solid var(--line);font-weight:700}
#modal .x{background:var(--ink);color:var(--bg);border:0;border-radius:8px;padding:6px 14px;font:700 15px "DM Sans",sans-serif;cursor:pointer}
#modal iframe{flex:1;border:0;width:100%;background:#fff}
@media (max-width:720px){.hero .wrap{grid-template-columns:1fr}.logo{width:150px;height:150px}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<nav><div class="wrap"><b>VYBRA</b><a href="#propuestas">Propuestas</a><a href="#participa">Participa</a><a href="#agenda">Agenda</a><a href="#equipo">Equipo</a></div></nav>

<header class="hero"><div class="wrap">
<div>
<h1>El cambio empieza <span style="color:#19B5FF">contigo</span></h1>
<p><b>Ideas que inspiran, acciones que transforman.</b><br>Somos VYBRA AHORA. Esta es nuestra plataforma para que conozcas el plan de trabajo, te inscribas en las actividades y nos digas qué quieres cambiar.</p>
<a class="btn" href="#propuestas">Ver las 18 propuestas</a><a class="btn alt" href="#participa">Participar</a>
</div>
<img class="logo" alt="Logo de VYBRA: guacamayo azul" src="data:image/webp;base64,">
</div></header>

<section id="propuestas"><div class="wrap">
<h2>Nuestras propuestas</h2>
<p class="lead">Dieciocho ideas para hacer más vivo el colegio. Filtra por el tema que más te interese.</p>
<div class="chips" id="chips" role="group" aria-label="Filtrar propuestas"></div>
<div class="grid" id="grid"></div>
</div></section>

<section id="participa" class="band"><div class="wrap">
<h2>Participa</h2>
<p class="lead">Tres formas de ser parte desde hoy.</p>
<div class="act">
<div class="card"><div><h3>Inscríbete</h3><p>Anótate en la Copa VYBRA, el elenco de danza, el EcoReto y más actividades.</p></div><a class="btn" href="#" data-form="inscripcion">Inscribirme</a></div>
<div class="card"><div><h3>Deja tu sugerencia</h3><p>Cuéntanos qué mejorar. Puedes hacerlo de forma anónima.</p></div><a class="btn" href="#" data-form="sugerencias">Enviar sugerencia</a></div>
<div class="card"><div><h3>Pasaporte VYBRA</h3><p>Asiste a las actividades, junta sellos y participa por sorpresas.</p></div><a class="btn" href="#" data-form="pasaporte">Quiero mi pasaporte</a></div>
</div>
</div></section>

<section id="agenda"><div class="wrap">
<h2>Agenda de actividades</h2>
<p class="lead">Aquí verás las próximas fechas.</p>
<div id="events"></div>
</div></section>

<section id="equipo" class="band"><div class="wrap">
<h2>Quiénes somos</h2>
<p class="lead">La plancha VYBRA AHORA.</p>
<ul class="team">
<li><b>Marianela Amy Alhuay Rojas</b><span>Alcaldesa</span></li>
<li><b>Dean Gael Coronado Sauñe</b><span>Teniente Alcalde</span></li>
<li><b>Grober Yandet Ochoa Rodas</b><span>1er Regidor de Educación, Cultura y Deporte</span></li>
<li><b>Fátima Sauñe Calle</b><span>2da Regidora de Salud y Medio Ambiente</span></li>
<li><b>Sayuri Ortiz Vega</b><span>3ra Regidora de Emprendimiento y Actividades Productivas</span></li>
<li><b>Mayli Choque Mallma</b><span>4ta Regidora de Derecho del Niño</span></li>
<li><b>Prinsel Anuel Huamani</b><span>5to Regidor de Comunicación y Tecnología de la Información</span></li>
</ul>
</div></section>

<footer><div class="wrap">VYBRA AHORA · Una comunidad que avanza unida · 2027</div></footer>
<div id="modal" role="dialog" aria-modal="true" aria-label="Formulario"><div class="box"><div class="bar"><span id="mt">Formulario</span><button class="x" id="mx">Cerrar</button></div><iframe id="mf" title="Formulario"></iframe></div></div>
<div id="toast" role="status"></div>

<script>
// ✏️ EDITA AQUÍ: pega los enlaces de tus Google Forms (déjalos vacíos si aún no los tienes)
var FORMS = { inscripcion: "", sugerencias: "", pasaporte: "" };
// ✏️ EDITA AQUÍ: agrega actividades como { fecha: "15 nov", titulo: "Función de Cine VYBRA", lugar: "Patio" }
var EVENTS = [];

var P = [
["Cine VYBRA","Cultura","Funciones de cine para disfrutar con tus compañeros."],
["VYBRA Deportes","Deporte","Actividades deportivas para todos los gustos y niveles."],
["Aula Verde","Ambiente","Un espacio verde para aprender y cuidar el entorno."],
["EcoReto","Ambiente","Retos para cuidar el planeta desde el colegio."],
["Intercambio masivo de regalos","Solidaridad","Un gran intercambio de regalos entre estudiantes."],
["Corazones Solidarios","Solidaridad","Campañas para ayudar a quienes más lo necesitan."],
["Elenco de danza","Cultura","Un grupo de baile abierto a quien quiera sumarse."],
["Plataforma digital","Comunidad","Este sitio: información, inscripciones y sugerencias en un solo lugar."],
["Concurso de rachas de Duolingo","Aprendizaje","Gana con tu constancia aprendiendo idiomas."],
["Radio VYBRA","Cultura","La radio del colegio, con música, noticias y tu voz."],
["Copa VYBRA","Deporte","Un campeonato para competir y divertirse."],
["Recuperación de la biblioteca","Aprendizaje","Una biblioteca renovada para leer y estudiar mejor."],
["VYBRA Awards","Comunidad","Reconocimientos para quienes hacen mejor al colegio."],
["Cápsula del tiempo","Comunidad","Guarda mensajes de hoy para abrirlos en el futuro."],
["Pasaporte VYBRA","Comunidad","Junta sellos al participar y gana sorpresas."],
["Música en los recreos","Cultura","Música en los recreos para que el descanso sea más alegre."],
["Paseo con ropa de calle","Comunidad","Ven con ropa de calle el día del paseo y disfruta con comodidad."],
["Agua para los baños","Salud","Un tanque Rotoplas para que los baños tengan agua y estén siempre limpios."]
];
var cats = ["Todas"].concat(P.map(function(p){return p[1]}).filter(function(c,i,a){return a.indexOf(c)===i}));
var cur = "Todas";
function render(){
  var chips = document.getElementById("chips"); chips.innerHTML = "";
  cats.forEach(function(c){
    var b = document.createElement("button"); b.className = "chip"; b.textContent = c;
    b.setAttribute("aria-pressed", String(c===cur));
    b.onclick = function(){ cur = c; render(); };
    chips.appendChild(b);
  });
  var g = document.getElementById("grid"); g.innerHTML = "";
  P.filter(function(p){return cur==="Todas"||p[1]===cur}).forEach(function(p){
    var d = document.createElement("article"); d.className = "card";
    d.innerHTML = '<span class="tag"></span><h3></h3><p></p>';
    d.children[0].textContent = p[1]; d.children[1].textContent = p[0]; d.children[2].textContent = p[2];
    g.appendChild(d);
  });
}
render();
var ev = document.getElementById("events");
if(!EVENTS.length){ ev.innerHTML = '<div class="empty">Aún no hay fechas publicadas. Pronto verás aquí las próximas actividades.</div>'; }
else EVENTS.forEach(function(e){
  var r = document.createElement("div"); r.className = "ev";
  r.innerHTML = '<b></b><div></div>'; r.children[0].textContent = e.fecha; r.children[1].textContent = e.titulo + (e.lugar ? " – " + e.lugar : "");
  ev.appendChild(r);
});
var t = document.getElementById("toast"), tm;
var modal=document.getElementById("modal"), mf=document.getElementById("mf");
function closeM(){ modal.classList.remove("open"); mf.src="about:blank"; }
document.getElementById("mx").onclick=closeM;
modal.addEventListener("click",function(e){ if(e.target===modal) closeM(); });
document.addEventListener("keydown",function(e){ if(e.key==="Escape") closeM(); });
function openForm(u,title){
  if(/docs\.google\.com\/forms/.test(u)){
    if(u.indexOf("embedded=true")<0) u += (u.indexOf("?")<0?"?":"&")+"embedded=true";
    document.getElementById("mt").textContent = title; mf.src = u; modal.classList.add("open");
  } else window.open(u,"_blank","noopener");
}
document.querySelectorAll("[data-form]").forEach(function(a){
  a.addEventListener("click", function(e){
    e.preventDefault();
    var u = FORMS[a.dataset.form];
    if(u){ openForm(u, a.textContent); return; }
    t.textContent = "Este formulario aún no está disponible. Vuelve pronto.";
    t.style.display = "block"; clearTimeout(tm); tm = setTimeout(function(){ t.style.display = "none"; }, 3500);
  });
});
</script>
</body>
</html>
